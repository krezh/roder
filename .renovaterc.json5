{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>krezh/renovate-config"],
  packageRules: [
    {
      matchPackageNames: [
        "wasm-bindgen",
        "wasm-bindgen-futures",
        "js-sys",
        "web-sys",
      ],
      groupName: "wasm-bindgen",
    },
    // kube depends on k8s-openapi and they must be upgraded together;
    // grouping them ensures Renovate waits until both have a compatible release.
    {
      matchPackageNames: ["kube", "k8s-openapi"],
      groupName: "kube",
      minimumGroupSize: 2,
    },
  ],
}
