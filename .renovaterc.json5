{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'local>krezh/renovate-config',
  ],
  nix: {
    enabled: true,
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^crates/xterm-vendor/src/lib\\.rs$/',
      ],
      matchStrings: [
        '// renovate: depName=(?<depName>\\S+)\\s+pub const \\w+: &str = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'npm',
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'after 1am and before 2am',
    ],
    automerge: true,
    automergeType: 'pr',
    ignoreTests: false,
  },
  packageRules: [
    {
      matchManagers: [
        'cargo',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
    },
    {
      matchPackageNames: [
        'wasm-bindgen',
        'wasm-bindgen-futures',
        'js-sys',
        'web-sys',
      ],
      groupName: 'wasm-bindgen',
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
    },
    {
      matchPackageNames: [
        'kube',
        'k8s-openapi',
      ],
      groupName: 'kube',
      minimumGroupSize: 2,
      separateMajorMinor: false,
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
    },
  ],
}
